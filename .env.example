# ── Shared hosted Supabase (default) ─────────────────────────────────────────────
# Publishable key: dashboard → Project Settings → API Keys (sb_publishable_...). Browser-safe.
NEXT_PUBLIC_SUPABASE_URL=https://mgsnustjmswvuhanhofw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_2MK_IQWmBJvze9KMHamTlA_74ru06pX

# Server only, never NEXT_PUBLIC_. Transaction pooler (port 6543), dashboard → Connect.
# Contains the database admin password: ask a teammate for it privately, never commit or post it.
# URL-encode special characters in the password. sslmode=require: postgres.js is unencrypted by default.
DATABASE_URL=postgresql://postgres.mgsnustjmswvuhanhofw:<db-password>@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# ── Local stack instead (npm run db:start; values from `npx supabase status`) ───
